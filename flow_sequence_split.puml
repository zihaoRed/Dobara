@startuml 回收流程
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title 回收流程

actor "用户" as User
participant "门店" as Store
participant "质检工具\n(PC)" as PCTool
participant "估价系统" as Price
participant "库存系统" as Stock
participant "商城" as Shop

User -> Store : 直接到店回收/换购
User -> Shop : 线上下单回收
Shop -> Shop : 生成回收订单
Shop -> Store : 推荐就近门店
User -> Store : 选择门店

Store -> User : 确认到店

Store -> PCTool : USB连接设备检测
PCTool -> PCTool : 执行设备质检
PCTool -> Price : PC自动关联 / APP扫码导入
Price -> Price : 生成质检报告(含QR码)
Price -> Price : 系统自动估价

Price -> User : 报价展示

alt [接受报价]
    Price -> Store : 通知成交
    Store -> User : 现金支付
    Store -> Stock : 设备入库
    Stock -> Shop : 自动上架至商城
else [拒绝报价]
    Price -> Store : 通知拒绝
    Store -> User : 归还设备
    Store -> Store : 交易取消
end

@enduml

@startuml 销售流程
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title 销售流程

actor "用户" as User
participant "商城" as Shop
participant "Razorpay" as Pay
participant "库存系统" as Stock
participant "门店" as Store

User -> Shop : 浏览商城
User -> Shop : 加入购物车/下单
Shop -> Pay : 跳转Razorpay支付

alt [支付成功]
    Pay -> Shop : 支付成功回调
    Shop -> Shop : 生成销售订单
    Shop -> Stock : 检索设备所在门店
    Shop -> Store : 发送订单通知
    Store -> Store : 查看待出库订单
    Store -> Stock : 出库打包发货
    Stock -> Stock : 库存扣减
    Store -> User : 配送到用户
else [支付失败]
    Pay -> User : 支付失败提示
    User -> Pay : 重新支付
end

@enduml

@startuml 售后流程
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title 售后流程

actor "用户" as User
participant "商城" as Shop
actor "管理员" as Admin
participant "门店" as Store
participant "Razorpay" as Pay

User -> Shop : 申请退货(7天内)
Shop -> Admin : 推送退货审核

Admin -> Admin : 审核退货申请

alt [审核通过]
    Admin -> User : 通知审核通过
    User -> Store : 退回设备
    Store -> Store : 门店收货确认
    Store -> Admin : 确认已收货
    Admin -> Pay : Razorpay原路退款
    Pay -> User : 退款到账
else [审核拒绝]
    Admin -> User : 拒绝退货(附原因)
end

@enduml

@startuml 管理后台
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title 管理后台

actor "管理员" as Admin
participant "门店" as Store
participant "商城" as Shop
participant "估价系统" as Price
participant "数据报表" as Report

Admin -> Store : 门店管理
Admin -> Shop : 用户角色管理
Admin -> Shop : 设备品类管理
Admin -> Price : 估价规则配置
Admin -> Report : 查看回收/销售/售后数据报表

@enduml
